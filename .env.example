# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# Friendly local URL for the app (any *.localhost name resolves to 127.0.0.1
# in Chrome/Edge/Firefox, no hosts-file edit needed)
LOCAL_HOST_URL=http://wattsplit.localhost
LOCAL_HOST_PORT=80

# --- Supabase ---------------------------------------------------------------
# Project Settings -> API: Project URL and the anon / publishable key.
# These two are public and get built into the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Only for projects still on the legacy JWT secret (Project Settings -> API ->
# JWT Settings). Leave empty if the project uses JWT signing keys.
SUPABASE_JWT_SECRET=

# Project Settings -> Database -> Connection string -> "Session pooler" URI.
# SECRET: contains the database password. Backend only.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-your-region.pooler.supabase.com:5432/postgres

# --- Email (Mailtrap) --------------------------------------------------------
# Supabase Auth sends sign-in codes through Mailtrap SMTP; the backend can also
# send email via app/mailer.py. Mailtrap -> Sending Domains -> your domain ->
# Integration -> API token. SECRET.
MAILTRAP_API_TOKEN=your-mailtrap-api-token
# Must be on a sending domain verified in Mailtrap. hello@demomailtrap.co works
# for testing, but only delivers to the email your Mailtrap account uses.
# Must be on a sending domain verified in Mailtrap (the demo domain only
# delivers to your own Mailtrap account email).
MAIL_FROM_EMAIL=wattsplit@jugadu.tech
MAIL_FROM_NAME=wattSplit

# Voice payments ("I added 500 rupees yesterday in DG"): 60db speech-to-text,
# app.60db.ai -> Settings -> Developer -> API Keys. SECRET. Empty = no mic button.
SIXTYDB_API_KEY=

# --- Local development only (never on Render) --------------------------------
# Sign in with code 123456 and no email, in `npm run dev` / the Android dev app.
# Supabase -> Project Settings -> API Keys -> service_role (or a secret key).
# FULL ADMIN ACCESS to the project: keep it in this file only. SECRET.
SUPABASE_SERVICE_ROLE_KEY=
# Who may use it: emails, "@domain" entries, or * for anyone. Empty = off.
DEV_LOGIN_EMAILS=

# Only for one-off setup scripts (python -m app.setup_auth_email). Personal
# access token from supabase.com/dashboard/account/tokens: full account access,
# so remove it from .env and revoke it after use.
SUPABASE_ACCESS_TOKEN=

# --- Android app ------------------------------------------------------------
# Deployed backend the APK calls (npm run apk). Must be https.
MOBILE_API_URL=https://wattsplit-api.onrender.com/api

# Public web address used in roommate invite links and as Supabase's site URL
# (optional; defaults to the page the owner is using), e.g. https://wattsplit.jugadu.tech
APP_URL=
